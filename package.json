{
  "name": "show-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline media presentation editor",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/KonradJuenger/ShowMe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KonradJuenger/ShowMe.git"
  },
  "bugs": {
    "url": "https://github.com/KonradJuenger/ShowMe/issues"
  },
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run verify:typescript && tsc --noEmit && vite build && npm run build:html-runtime && node scripts/build-electron.mjs",
    "typecheck": "npm run verify:typescript && tsc --noEmit",
    "typecheck:ts6": "tsc6 --noEmit --stableTypeOrdering --noUncheckedSideEffectImports",
    "verify:typescript": "node scripts/verify-typescript.mjs",
    "lint": "eslint src electron mcp tests *.ts",
    "test": "node scripts/test-suite.mjs core",
    "benchmark:animation": "node scripts/benchmark-animation.mjs",
    "benchmark:audience": "node scripts/benchmark-audience.mjs",
    "benchmark:images": "node scripts/benchmark-image-cache.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "desktop": "npm run build && electron .",
    "clean:reports": "node scripts/clean-reports.mjs",
    "package": "npm run build && electron-builder --publish never",
    "format": "prettier --write src electron tests scripts *.ts *.json",
    "test:core": "node scripts/test-suite.mjs core",
    "test:feature": "node scripts/test-suite.mjs feature",
    "test:extended": "node scripts/test-suite.mjs extended",
    "test:full": "node scripts/test-suite.mjs full",
    "test:release": "node scripts/test-suite.mjs release",
    "test:deprecated": "node scripts/test-suite.mjs deprecated",
    "test:stats": "node scripts/test-suite.mjs stats",
    "test:audit": "node scripts/test-suite.mjs audit",
    "benchmark:renderer": "node scripts/benchmark-renderer-workloads.mjs",
    "build:html-runtime": "vite build --config vite.html-export.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "ffmpeg-static": "5.3.0",
    "fontkit": "^2.0.4",
    "motion": "^14.0.0",
    "pica": "^10.0.3",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "^1.55.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.13.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.9.3",
    "electron-builder": "^26.16.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-a11y": "^2.5.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jszip": "^3.10.2",
    "prettier": "^3.9.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "org.showme.desktop",
    "productName": "ShowMe",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-html-export/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "src/assets/material-icons/LICENSE",
      "src/assets/material-icons/APACHE-2.0.txt"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "dist-electron/showme-mcp.cjs",
        "to": "showme-mcp.cjs"
      }
    ],
    "fileAssociations": [
      {
        "ext": "sme",
        "name": "ShowMe Presentation",
        "description": "ShowMe presentation document",
        "mimeType": "application/x-showme-presentation",
        "role": "Editor"
      },
      {
        "ext": "smp",
        "name": "ShowMe Packaged Presentation",
        "description": "ShowMe portable packaged presentation",
        "mimeType": "application/x-showme-packaged-presentation",
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/app-icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "build/app-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/ffmpeg-static/**/*"
    ]
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "^2.0.4"
    },
    "http-cache-semantics": "^4.3.0",
    "source-map-js": "^1.2.2",
    "@electron/get": {
      "global-agent": "^4.1.3"
    }
  }
}
