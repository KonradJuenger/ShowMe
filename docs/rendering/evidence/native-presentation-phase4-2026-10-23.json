  "harness": "import {execFileSync}from'node:child_process';import{createHash}from'node:crypto';import {_electron} from '@playwright/test';import fs from 'node:fs/promises';import path from 'node:path';const mode=process.env.FPS_MODE??'normal';const dir=path.resolve('.agenttmp/fps-user-'+Date.now());await fs.mkdir(dir,{recursive:true});const settings=JSON.parse(await fs.readFile(path.join(process.env.APPDATA,'show-me','settings.json'),'utf8'));await fs.writeFile(path.join(dir,'settings.json'),JSON.stringify(settings));const env={...process.env};delete env.ELECTRON_RUN_AS_NODE;let app;try{app=await _electron.launch({args:[path.resolve('.'),'--user-data-dir='+dir,'D:/01_Projekte/06_presentations/showme-examples/shader-text-shader.sme'],env});const editor=await app.firstWindow();await editor.getByTestId('stage').waitFor();if(mode==='no-presenter')await app.evaluate(({BrowserWindow})=>{const original=BrowserWindow.prototype.loadFile;BrowserWindow.prototype.loadFile=function(file,options){if(options?.query?.present==='console'){this.hide();return this.loadURL('about:blank');}return original.call(this,file,options);};});await app.context().addInitScript(()=>{window.__gpuCanvases=new Set();for(const proto of [OffscreenCanvas.prototype,HTMLCanvasElement.prototype]){const get=proto.getContext;proto.getContext=function(kind,...args){const value=get.call(this,kind,...args);if(value&&kind==='webgl2')window.__gpuCanvases.add(this);return value;};}});await editor.getByRole('button',{name:'Present',exact:true}).click();await new Promise(r=>setTimeout(r,1500));const audience=app.windows().find(p=>p.url().includes('present=audience'));if(!audience)throw Error('Audience not found');const sessions=[];for(const p of app.windows()){const c=await p.context().newCDPSession(p);await c.send('Performance.enable');sessions.push({p,publications:await p.evaluate(()=>[...document.querySelectorAll('[data-effect-id]')].map(n=>({id:n.dataset.effectId,revision:Number(n.dataset.effectRevision??0)}))),name:p.url().includes('present=audience')?'audience':p.url().includes('present=console')?'presenter':p.url().includes('slidePreview')?'thumbnail':p.url()==='about:blank'?'disabled-presenter':'editor',c,before:(await c.send('Performance.getMetrics')).metrics});}const result=await audience.evaluate(async()=>{const frames=[];const initial=new Map([...document.querySelectorAll(\"[data-effect-id]\")].map(n=>[n.dataset.effectId,Number(n.dataset.effectRevision??0)]));const start=performance.now();let last=start;await new Promise(resolve=>{const tick=now=>{frames.push(now-last);last=now;if(now-start<10000)requestAnimationFrame(tick);else resolve();};requestAnimationFrame(tick);});const sorted=frames.slice(2).sort((a,b)=>a-b);const canvases=[...(window.__gpuCanvases??[])].map(c=>({width:c.width,height:c.height}));const gl=new OffscreenCanvas(1,1).getContext('webgl2');const ext=gl.getExtension('WEBGL_debug_renderer_info');return {webglCanvases:canvases,logicalColorBufferBytes:canvases.reduce((n,c)=>n+c.width*c.height*4,0),durationMs:last-start,frames:frames.length,fps:1000*frames.length/(last-start),p50Ms:sorted[Math.floor(sorted.length*.5)],p95Ms:sorted[Math.floor(sorted.length*.95)],maxMs:sorted.at(-1),width:innerWidth,height:innerHeight,dpr:devicePixelRatio,gpu:gl.getParameter(ext.UNMASKED_RENDERER_WEBGL),effects:[...document.querySelectorAll('[data-effect-id]')].map(n=>({id:n.dataset.effectId,sceneAssembly:n.dataset.effectSceneAssembly,ready:n.dataset.effectReady,error:n.dataset.effectError,revision:n.dataset.effectRevision,updatesPerSecond:1000*(Number(n.dataset.effectRevision??0)-(initial.get(n.dataset.effectId)??0))/(last-start)}))};});result.mode=mode;result.cpu={};result.windowPublications={};for(const {name,c,before,p,publications}of sessions){const after=(await c.send('Performance.getMetrics')).metrics;result.windowPublications[name]=await p.evaluate(({publications,seconds})=>[...document.querySelectorAll('[data-effect-id]')].map(n=>({id:n.dataset.effectId,updates